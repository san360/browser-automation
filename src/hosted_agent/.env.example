# Copy to .env for local runs (`python main.py` or `azd ai agent run`). Values come from `azd env get-values`.
FOUNDRY_PROJECT_ENDPOINT="https://<account>.services.ai.azure.com/api/projects/<project>"
AZURE_AI_MODEL_DEPLOYMENT_NAME="gpt-4.1-mini"
TOOLBOX_NAME="browser-automation-tools"
DEMO_SITE_URL="https://<demo-site>.azurecontainerapps.io"
ALLOWED_SCAN_HOSTS="<demo-site>.azurecontainerapps.io"
# Use azd's sign-in when the Azure CLI is signed in to a different tenant:
AZURE_TOKEN_CREDENTIALS="AzureDeveloperCliCredential"
# Or pick the Azure CLI account that owns this subscription, even if the CLI's default account is in another tenant
# (demo_cli's local mode sets this for you):
# AZURE_CLI_SUBSCRIPTION="<subscription-id>"
# Browser: "toolbox" (Foundry Browser Automation tool, cloud browser) or "local" (Playwright MCP on this machine, needs
# Node.js; binds the server to 127.0.0.1). `python -m demo_cli run <scenario> --mode local` sets all of this for you.
BROWSER_BACKEND="toolbox"
# LOCAL_BROWSER="msedge"            # local backend: msedge (Windows default), chrome, firefox or webkit
# LOCAL_BROWSER_HEADLESS="false"    # local backend: show the browser window
# AGENT_HOST="127.0.0.1"            # bind address; keep loopback on a dev machine (the server has no authentication)
# Optional tuning (defaults shown). BROWSER_TOOLS is a comma-separated allow-list of toolbox browser tools.
# CONTEXT_BUDGET_TOKENS="48000"
# The agent server records prompts and tool results in telemetry unless this is "false":
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT="false"
